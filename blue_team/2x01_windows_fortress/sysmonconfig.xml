<?xml version="1.0" encoding="utf-8"?>
<!--
  MedDefense Sysmon Configuration
  Purpose: High-value Windows endpoint telemetry for lateral movement,
           credential theft, persistence, ransomware staging and exfiltration.
  Author: MedDefense Blue Team
  Date: 2026-10-19

  Independently authored for the Windows Fortress lab, informed by the
  detection priorities of SwiftOnSecurity/sysmon-config:
  https://github.com/SwiftOnSecurity/sysmon-config

  The original SwiftOnSecurity baseline is downloaded separately by the
  deployment script, with attribution to its CC BY 4.0 author. This file is
  not a reproduction of that reference configuration.

  IMPORTANT: Filtering preserves high-value signals but does not collect
  every event. Event ID 11 deliberately covers the Task 9 validation file.
-->
<Sysmon schemaversion="4.50">
  <HashAlgorithms>sha256</HashAlgorithms>
  <CheckRevocation />
  <EventFiltering>
    <!-- Event 1: preserve process execution and parent/command-line context. -->
    <RuleGroup name="Process execution" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
    </RuleGroup>

    <!-- Event 2: potential timestomping of executable/script files. -->
    <RuleGroup name="File timestamp manipulation" groupRelation="or">
      <FileCreateTime onmatch="include">
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
      </FileCreateTime>
    </RuleGroup>

    <!-- Event 3: likely lateral movement or PowerShell/Rclone communication. -->
    <RuleGroup name="Suspicious network connections" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">\rclone.exe</Image>
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\psexec.exe</Image>
        <Image condition="end with">\wmic.exe</Image>
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">3389</DestinationPort>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event 6: unusual drivers can support kernel-level persistence. -->
    <RuleGroup name="Driver loading" groupRelation="or">
      <DriverLoad onmatch="exclude" />
    </RuleGroup>

    <!-- Event 8: remote-thread injection, often used by post-exploitation tools. -->
    <RuleGroup name="Remote thread injection" groupRelation="or">
      <CreateRemoteThread onmatch="exclude" />
    </RuleGroup>

    <!-- Event 10: sensitive access to LSASS, a credential-theft signal. -->
    <RuleGroup name="Credential access" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">\lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event 11: suspicious file drops, persistence and explicit lab test. -->
    <RuleGroup name="Suspicious file creation" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="MedDefense Sysmon lab validation" condition="begin with">C:\Windows\Temp\sysmon_test</TargetFilename>
        <TargetFilename condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="contains">\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename condition="begin with">C:\Users\Public\</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.cmd</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Events 12-14: common autorun, policy and service persistence keys. -->
    <RuleGroup name="Registry persistence" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\Policies\System</TargetObject>
        <TargetObject condition="contains">\Services\</TargetObject>
        <TargetObject condition="contains">\Windows Defender\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event 15: downloaded or staged content with alternate streams. -->
    <RuleGroup name="File stream evidence" groupRelation="or">
      <FileCreateStreamHash onmatch="include">
        <TargetFilename condition="contains">\Downloads\</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>

    <!-- Events 17-18: named pipes often associated with remote execution. -->
    <RuleGroup name="Remote execution pipes" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName condition="contains">psexesvc</PipeName>
        <PipeName condition="contains">remcom</PipeName>
        <PipeName condition="contains">paexec</PipeName>
        <PipeName condition="contains">csexec</PipeName>
        <PipeName condition="contains">\svcctl</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- Events 19-21: WMI persistence through filters and consumers. -->
    <RuleGroup name="WMI persistence" groupRelation="or">
      <WmiEvent onmatch="exclude" />
    </RuleGroup>

    <!-- Event 22: DNS visibility for typical post-exploitation processes. -->
    <RuleGroup name="Suspicious DNS queries" groupRelation="or">
      <DnsQuery onmatch="include">
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\rclone.exe</Image>
        <Image condition="end with">\cmd.exe</Image>
        <Image condition="end with">\wscript.exe</Image>
      </DnsQuery>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
